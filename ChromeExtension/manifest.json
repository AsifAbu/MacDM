{
  "manifest_version": 3,
  "name": "MacDM",
  "description": "Send downloads and videos from Chrome to MacDM.",
  "version": "1.0",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MacDM",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
