{
  "manifest_version": 2,
  "name": "MacDM",
  "description": "Download videos and files from any page with MacDM.",
  "version": "1.0",
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["nativeMessaging", "<all_urls>", "http://127.0.0.1/*"]
}
